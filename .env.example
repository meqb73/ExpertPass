# Network and contract the app talks to. Everything else (USDC address, RPC, explorer) follows from these two.
#
#   VITE_CHAIN_ID: 5042002 = Arc Testnet (default), 5042 = Arc Mainnet
#   VITE_EXPERTPASS_ADDRESS: the ExpertPass contract deployed on that network
#
# Restart the dev server (or rebuild) after changing them; Vite reads .env only at startup.
VITE_CHAIN_ID=5042
VITE_EXPERTPASS_ADDRESS=0x0000000000000000000000000000000000000000

# Arc Testnet example (previous deployment):
# VITE_CHAIN_ID=5042002
# VITE_EXPERTPASS_ADDRESS=0xdec618bb277e4ab5857dfdd4dfc7ae645a7c6148
